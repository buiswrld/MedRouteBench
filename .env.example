# Copy to `.env`. Select one inference provider; keep keys out of Git.
LLM_PROVIDER=azure

# Azure inference (the existing default).
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=

# OpenRouter inference. OPENROUTER_KEY is accepted as a legacy key name.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-9b
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=
# OPENROUTER_APP_NAME=MedRouteBench

# Keep the MedCTA judge fixed across candidate-model runs. The team currently
# uses an Azure gpt-5.4 deployment even when candidate inference uses OpenRouter.
MEDCTA_JUDGE_PROVIDER=azure
MEDCTA_JUDGE_DEPLOYMENT=

# MEDCTA_MAX_RETRY_WAIT_SECONDS=60
# MEDCTA_IMAGE_URL_CACHE_TTL_SECONDS=2700
# MEDCTA_REASONING_EFFORT=none
