# Copy to `.env` and fill in your OpenRouter credentials.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_KEY is accepted as a legacy alias for OPENROUTER_API_KEY.

# Keep the MedCTA judge fixed across candidate-model runs. The current protocol
# uses a GPT-5.4 Azure deployment.
MEDCTA_JUDGE_PROVIDER=azure
MEDCTA_JUDGE_DEPLOYMENT=gpt-5.4
JUDGE_MODEL_FAMILY=openai
JUDGE_AZURE_ENDPOINT=
JUDGE_AZURE_API_KEY=
# JUDGE_AZURE_DEPLOYMENT=gpt-5.4

# For an OpenRouter judge instead, set MEDCTA_JUDGE_PROVIDER=openrouter and:
# MEDCTA_JUDGE_MODEL=openai/gpt-5.4
# MEDCTA_JUDGE_API_KEY=
# Optional: override the base URL (defaults to https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=
# All pipelines also accept --api-key on the command line to override
# OPENROUTER_API_KEY per invocation, the same way --model overrides OPENROUTER_MODEL.
# MEDCTA_IMAGE_URL_CACHE_TTL_SECONDS=2700
