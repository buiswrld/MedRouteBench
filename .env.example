# Copy to `.env` and fill in your Groq API key (free tier at https://console.groq.com).
GROQ_API_KEY=

# Optional model override; defaults to llama-3.1-8b-instant
# GROQ_MODEL=llama-3.1-8b-instant

# Idea #3 MedCTA uses a separate multimodal-model setting.
# MEDCTA_MODEL=qwen/qwen3.6-27b
# MEDCTA_TEMPERATURE=0.0
# MEDCTA_MAX_TOKENS=512
# MEDCTA_MAX_RETRIES=5
# MEDCTA_MAX_RETRY_WAIT_SECONDS=60
# MEDCTA_IMAGE_URL_CACHE_TTL_SECONDS=2700
# MEDCTA_REASONING_EFFORT=none
