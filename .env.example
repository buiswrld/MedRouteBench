# Copy to `.env` and fill in your OpenRouter credentials.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MEDCTA_JUDGE_MODEL=
# Optional: use a separate API key for MedCTA judge calls (defaults to OPENROUTER_API_KEY).
# MEDCTA_JUDGE_API_KEY=
# Optional: override the base URL (defaults to https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=
# All pipelines also accept --api-key on the command line to override
# OPENROUTER_API_KEY per invocation, the same way --model overrides OPENROUTER_MODEL.
# Optional: override the model used for MedCTA inference (same as OPENROUTER_MODEL above).
# OPENROUTER_MODEL=openai/gpt-5-mini
# MEDCTA_MAX_RETRY_WAIT_SECONDS=60
# MEDCTA_IMAGE_URL_CACHE_TTL_SECONDS=2700
# MEDCTA_REASONING_EFFORT=none
