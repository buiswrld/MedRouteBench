# Copy to `.env` and fill in your Azure credentials.
AZURE_ENDPOINT=
AZURE_API_KEY=
AZURE_DEPLOYMENT=
# Optional: override the Azure deployment used for MedCTA inference (same as AZURE_DEPLOYMENT above).
# AZURE_DEPLOYMENT=gpt-5-mini
# MEDCTA_MAX_RETRY_WAIT_SECONDS=60
# MEDCTA_IMAGE_URL_CACHE_TTL_SECONDS=2700
# MEDCTA_REASONING_EFFORT=none

# Separate LLM-as-a-judge deployment. Prefer a different model family from the
# candidate model. If endpoint/key are omitted, the ordinary Azure values above
# are reused; the deployment and family must still be explicit.
JUDGE_AZURE_ENDPOINT=
JUDGE_AZURE_API_KEY=
JUDGE_AZURE_DEPLOYMENT=
JUDGE_MODEL_FAMILY=
# JUDGE_TEMPERATURE=0
# JUDGE_REASONING_EFFORT=none
# JUDGE_MAX_TOKENS=512
# JUDGE_MAX_RETRIES=5
# JUDGE_MAX_RETRY_WAIT_SECONDS=60
